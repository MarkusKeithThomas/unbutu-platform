# Quy tắc dùng Lombok cho toàn repo (áp dụng cho mọi thư mục con).
config.stopBubbling = true

# Đánh dấu code sinh ra là @Generated → công cụ đo coverage bỏ qua.
lombok.addLombokGeneratedAnnotation = true

# CẤM: equals/hashCode/toString tự sinh gây lỗi với entity JPA (lazy loading, vòng lặp quan hệ 2 chiều).
# Kiểu giá trị (DTO, event) dùng Java record thay thế.
lombok.data.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.value.flagUsage = error

# Logger tên `log` cho @Slf4j.
lombok.log.fieldName = log
